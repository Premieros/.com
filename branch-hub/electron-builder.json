{
  "appId": "com.premieros.branchhub",
  "productName": "PremierOS Branch Hub",
  "directories": {
    "output": "release"
  },
  "files": [
    "*.cjs",
    "!*.test.cjs",
    "!*.browser.cjs",
    "!desktop-shell-smoke.cjs",
    "package.json",
    "ui/**",
    "browser-app/**"
  ],
  "asar": true,
  "extraResources": [
    { "from": "native-runtime", "to": "branch-windows", "filter": ["Premier.Windows.exe", "LICENSE.txt", "ThirdPartyNotices.txt"] }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "PremierOS-Branch-Hub-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "runAfterFinish": false
  }
}
